rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function hasProfile() {
      return isSignedIn() && exists(userPath());
    }

    function profile() {
      return get(userPath()).data;
    }

    function isAdmin() {
      return hasProfile()
        && profile().role == 'admin'
        && profile().congregationId is string
        && profile().congregationId.size() > 0;
    }

    // congregationId tem de ser string não vazia e igual à do usuário.
    // Documento sem o campo não entra em congregação nenhuma.
    function inCongregation(data) {
      return hasProfile()
        && data.congregationId is string
        && data.congregationId.size() > 0
        && data.congregationId == profile().congregationId;
    }

    function keepsCongregation() {
      return request.resource.data.congregationId == resource.data.congregationId;
    }

    function adminWritesConfig() {
      return isAdmin() && inCongregation(resource.data) && keepsCongregation();
    }

    function adminCreates() {
      return isAdmin() && inCongregation(request.resource.data);
    }

    function managesMeetings() {
      return isAdmin()
        || (hasProfile()
          && profile().manageFlags is list
          && 'meetings' in profile().manageFlags);
    }

    function canReadMeetingProgram(data) {
      return inCongregation(data) && (
        managesMeetings()
        || (data.status == 'published'
          && profile().accessFlags is list
          && 'meetings' in profile().accessFlags)
      );
    }

    function segmentProgressOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['status', 'lastWorkedDate']);
    }

    match /congregations/{congregationId} {
      allow read: if hasProfile()
        && congregationId == profile().congregationId;
      allow update: if isAdmin()
        && congregationId == profile().congregationId;
      allow create, delete: if false;
    }

    match /users/{userId} {
      allow get: if hasProfile() && (
        userId == request.auth.uid
        || inCongregation(resource.data)
      );
      allow list: if inCongregation(resource.data);
      allow create: if false;
      allow update: if hasProfile()
        && request.resource.data.role == resource.data.role
        && keepsCongregation()
        && (
          (userId == request.auth.uid
            && request.resource.data.get('accessFlags', null)
                == resource.data.get('accessFlags', null)
            && request.resource.data.get('manageFlags', null)
                == resource.data.get('manageFlags', null))
          || (isAdmin() && inCongregation(resource.data))
        );
      allow delete: if isAdmin() && inCongregation(resource.data);
    }

    match /territories/{territoryId} {
      allow read: if inCongregation(resource.data);
      allow create: if adminCreates();
      allow update: if adminWritesConfig();
      allow delete: if isAdmin() && inCongregation(resource.data);
    }

    match /segments/{segmentId} {
      allow read: if inCongregation(resource.data);
      allow create: if adminCreates();
      allow update: if inCongregation(resource.data)
        && keepsCongregation()
        && (isAdmin() || segmentProgressOnly());
      allow delete: if isAdmin() && inCongregation(resource.data);
    }

    match /neighborhoods/{neighborhoodId} {
      allow read: if inCongregation(resource.data);
      allow create: if adminCreates();
      allow update: if adminWritesConfig();
      allow delete: if isAdmin() && inCongregation(resource.data);
    }

    match /meetingLocations/{locationId} {
      allow read: if inCongregation(resource.data);
      allow create: if adminCreates();
      allow update: if adminWritesConfig();
      allow delete: if isAdmin() && inCongregation(resource.data);
    }

    match /fieldGroups/{groupId} {
      allow read: if inCongregation(resource.data);
      allow create: if adminCreates();
      allow update: if adminWritesConfig();
      allow delete: if isAdmin() && inCongregation(resource.data);
    }

    match /preachingSessions/{sessionId} {
      allow read: if inCongregation(resource.data);
      allow create: if adminCreates();
      allow update: if adminWritesConfig();
      allow delete: if isAdmin() && inCongregation(resource.data);
    }

    match /assignments/{assignmentId} {
      allow read: if inCongregation(resource.data);
      allow create: if adminCreates();
      allow update: if adminWritesConfig();
      allow delete: if isAdmin() && inCongregation(resource.data);
    }

    match /workSessions/{sessionId} {
      allow read: if inCongregation(resource.data);
      allow create: if inCongregation(request.resource.data)
        && (
          isAdmin()
          || request.resource.data.conductorId == request.auth.uid
        );
      allow update, delete: if false;
    }

    match /announcements/{announcementId} {
      allow read: if inCongregation(resource.data);
      allow create: if adminCreates();
      allow update: if adminWritesConfig();
      allow delete: if isAdmin() && inCongregation(resource.data);
    }

    match /publishers/{publisherId} {
      allow read: if inCongregation(resource.data)
        && (isAdmin()
          || (profile().accessFlags is list
            && 'publishers' in profile().accessFlags));
      allow create: if adminCreates();
      allow update: if adminWritesConfig();
      allow delete: if isAdmin() && inCongregation(resource.data);
    }

    match /meetingPrograms/{meetingId} {
      allow read: if canReadMeetingProgram(resource.data);
      allow create, update, delete: if false;
    }

    match /meetingImports/{importId} {
      allow read: if managesMeetings() && inCongregation(resource.data);
      allow create, update, delete: if false;
    }

    // Apenas Cloud Functions (Admin SDK). Clientes nunca acedem.
    match /passwordResetRequests/{tokenId} {
      allow read, write: if false;
    }
  }
}
