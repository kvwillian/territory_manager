rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userData() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function managesMeetings(congregationId) {
      return signedIn()
        && userData().congregationId == congregationId
        && (
          userData().role == 'admin'
          || (userData().manageFlags is list && 'meetings' in userData().manageFlags)
        );
    }

    match /meeting-imports/{congregationId}/{importId}/{fileName} {
      allow read: if false;
      allow create, update: if managesMeetings(congregationId)
        && fileName == 'source.pdf'
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow delete: if managesMeetings(congregationId) && fileName == 'source.pdf';
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
