{
  "name": "territory-manager-functions",
  "description": "Cloud Functions for Territory Manager",
  "scripts": {
    "build": "tsc",
    "serve": "npm run build && firebase emulators:start --only functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "stamp-congregation-ids": "npm run build && node lib/stampCongregationIds.js",
    "test": "tsx --test test/workbook.test.ts",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "20"
  },
  "main": "lib/index.js",
  "dependencies": {
    "dotenv": "^16.4.7",
    "firebase-admin": "^12.0.0",
    "firebase-functions": "^5.0.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0"
  },
  "private": true
}
